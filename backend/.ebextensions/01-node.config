# Elastic Beanstalk platform config for Node.js.
# Node 20 is required (see engines in package.json — firebase-admin/prisma
# transitive deps break on older Node). EB's Amazon Linux 2023 Node.js
# platform supports Node 20 out of the box.
option_settings:
  aws:elasticbeanstalk:container:nodejs:
    NodeCommand: "npm start"
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /health
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx
