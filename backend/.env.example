NODE_ENV=development
PORT=4000

DATABASE_URL=
DIRECT_URL=

JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v20.0

FRONTEND_URL=http://localhost:5173
ENCRYPTION_KEY=

# Firebase Admin — required for Google sign-in.
# Copy from the service-account JSON downloaded from Firebase console
# (Project settings → Service accounts → Generate new private key).
# For FIREBASE_PRIVATE_KEY: paste the whole key on one line, keep the \n
# escape sequences intact (do NOT convert them to real newlines).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Resend — for password-reset emails.
# Get an API key from https://resend.com/api-keys (free tier: 3k/mo).
# When RESEND_API_KEY is empty, /auth/forgot-password prints the reset link
# to the backend console instead of sending — fine for local dev.
# EMAIL_FROM must be a verified sender domain in Resend, or use
# "onboarding@resend.dev" for testing (their shared onboarding domain).
RESEND_API_KEY=
EMAIL_FROM=Xavier <onboarding@resend.dev>
