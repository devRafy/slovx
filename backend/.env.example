NODE_ENV=development
PORT=4000

DATABASE_URL=
DIRECT_URL=

JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v20.0

FRONTEND_URL=http://localhost:5173
ENCRYPTION_KEY=

# Firebase Admin — required for Google sign-in.
# Copy from the service-account JSON downloaded from Firebase console
# (Project settings → Service accounts → Generate new private key).
# For FIREBASE_PRIVATE_KEY: paste the whole key on one line, keep the \n
# escape sequences intact (do NOT convert them to real newlines).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SMTP — for password-reset emails (via Nodemailer).
# When SMTP_HOST/USER/PASS are empty, /auth/forgot-password prints the reset
# link to the backend console instead of sending — fine for local dev.
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled). SMTP_PASS is that 16-char app password,
# NOT your Gmail login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password_here
EMAIL_FROM=Xavier <your@gmail.com>
