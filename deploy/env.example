# backend/.env — copy this file to backend/.env on the EC2 instance and
# fill in real values. NEVER commit the filled-in version.

NODE_ENV=production
PORT=8080

# ── Supabase (auth + database) ──────────────────────────────────
DATABASE_URL=<pooled connection string from Supabase>
DIRECT_URL=<direct connection string from Supabase>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role secret>
SUPABASE_JWT_SECRET=<JWT secret from Project Settings → API>

# ── Anthropic (Claude) ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Meta / WhatsApp ─────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v20.0

# ── App ─────────────────────────────────────────────────────────
FRONTEND_URL=http://<your-EC2-public-IP>
# Optional: additional CORS origins, comma-separated. *.vercel.app is
# always allowed by server.js, no need to list preview URLs here.
EXTRA_FRONTEND_ORIGINS=

# 32+ char random string, e.g.
#   openssl rand -base64 48
ENCRYPTION_KEY=
