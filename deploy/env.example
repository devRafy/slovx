# backend/.env — copy this file to backend/.env on the EC2 instance and
# fill in real values. NEVER commit the filled-in version.

NODE_ENV=production
PORT=8080

# ── Local Postgres (installed by bootstrap.sh on the same EC2) ──────
# Bootstrap saves the generated password to ~/.xavier_db — read it with:
#   cat ~/.xavier_db
# Both URLs point at the same local Postgres. Prisma uses DATABASE_URL at
# runtime and DIRECT_URL for migrations — they're identical here since we
# aren't using a connection pooler.
DATABASE_URL=postgresql://xavier:<paste-password-from-~/.xavier_db>@127.0.0.1:5432/xavier
DIRECT_URL=postgresql://xavier:<paste-password-from-~/.xavier_db>@127.0.0.1:5432/xavier

# ── JWT secrets ─────────────────────────────────────────────────────
# Generate each with:  openssl rand -base64 48
# Must be at least 32 chars. Do not reuse across secrets.
JWT_SECRET=<32+ char random>
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=<different 32+ char random>
JWT_REFRESH_EXPIRES_IN=30d

# ── Anthropic (Claude) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Meta / WhatsApp ─────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v20.0

# ── App ─────────────────────────────────────────────────────────────
# The dashboard SPA lives at app.slovx.com. Used for CORS, password-reset
# links, and any other backend-generated URLs that point users at the app.
FRONTEND_URL=https://app.slovx.com
# Additional CORS origins, comma-separated. The landing domain and its www
# alias need to be here so any fetch() calls from the marketing pages work.
EXTRA_FRONTEND_ORIGINS=https://slovx.com,https://www.slovx.com

# 32+ char random string (openssl rand -base64 48)
ENCRYPTION_KEY=<32+ char random>

# ── Firebase Admin (optional — only if you want Google sign-in) ─────
# Leave empty to disable Google sign-in. Backend returns 501 for /auth/google
# in that case; email/password auth keeps working.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste with literal \n between lines (or with real newlines if your editor allows)
FIREBASE_PRIVATE_KEY=

# ── SMTP (optional — only if you want password-reset emails) ────────
# When SMTP_HOST/USER/PASS are empty, forgot-password logs the reset link
# to pm2 logs instead of sending — fine for testing. Gmail app password
# example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Xavier <no-reply@example.com>
