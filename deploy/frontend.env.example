# frontend/.env.production — copy this file to frontend/.env.production
# on the EC2 instance. Vite bakes these into the JS bundle at build time,
# so a rebuild is required after editing.

# Empty string = same-origin API calls (nginx proxies /api/* to :8080).
VITE_API_URL=

# ── Firebase (optional — only if you want Google sign-in) ───────────
# Match the same Firebase project as FIREBASE_PROJECT_ID on the backend.
# Leave empty to hide the "Continue with Google" button.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
