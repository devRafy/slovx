# frontend/.env.production — copy this file to frontend/.env.production
# on the EC2 instance and fill in the Supabase values. Vite bakes these
# into the JS bundle at build time, so a rebuild is required after edit.

# Empty string = same-origin API calls (nginx proxies /api/* to :8080).
VITE_API_URL=

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
