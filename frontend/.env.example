# Meta Embedded Signup — get these from your Meta App Dashboard
VITE_META_APP_ID=your_meta_app_id_here
VITE_META_CONFIG_ID=your_whatsapp_embedded_signup_config_id_here

# Firebase Web config — required for "Continue with Google".
# Get these from Firebase console → Project settings → Your apps → Web app config.
# The Google button is hidden automatically if these are empty.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
